{
  "name": "erp-integration-lab",
  "version": "0.1.0",
  "description": "Internal operations platform (leave management, later warehouse + ERP sync) built with NestJS and PostgreSQL, with a layered test suite.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "test": "jest",
    "test:api": "jest --config test/jest-api.config.js --runInBand",
    "test:all": "npm test && npm run test:api"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.12",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "typescript": "5.9.3"
  }
}
