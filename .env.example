# Copy to .env (never commit .env). Defaults below are for local development only.
DATABASE_URL=postgres://lab:lab@localhost:5432/erplab
JWT_SECRET=change-me-local-only
SEED_PASSWORD=Passw0rd!
PORT=3000

# ERP (SAP Business One Service Layer, or the mock in mock-erp/)
ERP_BASE_URL=http://localhost:50000/b1s/v1
ERP_COMPANY_DB=DEMO_COMPANY
ERP_USER=manager
ERP_PASSWORD=demo-only

# Background sync worker (0 = only manual sync via POST /erp-sync/run)
SYNC_INTERVAL_MS=10000
SYNC_MAX_ATTEMPTS=5
SYNC_BACKOFF_MS=30000
